{
  "name": "agent2llm",
  "version": "0.1.0",
  "description": "Mix any AI reasoning client with any coding harness.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "packages/brains/*",
    "packages/harnesses/*",
    "packages/workflows/*"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "rebuild": "node scripts/clean.mjs && tsc -b tsconfig.json",
    "typecheck": "tsc -b tsconfig.json",
    "test": "node scripts/run-tests.mjs",
    "lint": "node scripts/lint.mjs",
    "verify": "npm run typecheck && npm run test",
    "a2l": "node apps/cli/dist/index.js"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^22.15.0",
    "typescript": "^5.9.0"
  }
}
