{
  "name": "agent2llm",
  "version": "0.2.0",
  "description": "Mix any AI reasoning client with any coding harness.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "packages/brains/*",
    "packages/harnesses/*",
    "packages/workflows/*"
  ],
  "scripts": {
    "build": "npm run build:dock && tsc -b tsconfig.json",
    "build:dock": "tsc -p apps/dock/tsconfig.client.json && node apps/dock/build.mjs",
    "rebuild": "node scripts/clean.mjs && npm run build:dock && tsc -b tsconfig.json",
    "typecheck": "tsc -b tsconfig.json",
    "test": "node scripts/run-tests.mjs",
    "lint": "node scripts/lint.mjs",
    "verify": "npm run typecheck && npm run test",
    "bundle": "node scripts/bundle.mjs",
    "pack": "node scripts/bundle.mjs && node scripts/pack.mjs",
    "package:sea": "node scripts/package-sea.mjs",
    "a2l": "node apps/cli/dist/index.js",
    "e2e:relay": "node scripts/e2e-relay.mjs"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^22.15.0",
    "esbuild": "^0.28.2",
    "playwright": "^1.63.0",
    "postject": "^1.0.0-alpha.6",
    "typescript": "^5.9.0"
  }
}
